// OmicsFusion Nextflow configuration (spec section 4 / 23)

manifest {
    name            = 'OmicsFusion'
    description     = 'Modular multi-omics analysis and integration'
    author          = 'OmicsFusion Contributors'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    config  = null      // path to a project.yaml; if set, takes precedence over the individual inputs below
    rna          = null
    proteomics   = null
    metabolomics = null
    metadata     = null
    outdir       = 'results'
    help         = false
}

// Every stage is cacheable/resumable by Nextflow's own content-hash based
// -resume mechanism: as long as the config and input files are unchanged,
// `nextflow run main.nf -resume` skips already-completed processes.
workDir = 'work'

profiles {
    local {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        process.container = 'omicsfusion:latest'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = 'docker://omicsfusion:latest'
    }
    conda {
        conda.enabled = true
        process.conda = "$projectDir/../environment.yml"
    }
}

includeConfig 'conf/base.config'

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
